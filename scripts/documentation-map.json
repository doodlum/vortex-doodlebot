{
  "groups": [
    {
      "name": "Plugins and commands",
      "sources": ["^plugins/", "^\\.claude-plugin/", "^\\.agents/plugins/"],
      "human": ["docs/reference/commands.md", "docs/get-started/install.md"],
      "ai": ["AGENTS.md", "harness/AGENTS.md"]
    },
    {
      "name": "MCP and renderer tools",
      "sources": ["^src/.*\\.ts$"],
      "human": [
        "docs/reference/mcp-tools.md",
        "docs/guides/drive-vortex.md",
        "docs/security.md",
        "docs/troubleshooting.md"
      ],
      "ai": [
        "harness/reference/mcp-tools.md",
        "harness/AGENTS.md",
        "ARCHITECTURE.md",
        "KNOWLEDGE.md"
      ]
    },
    {
      "name": "CLI and configuration",
      "sources": [
        "^bin/",
        "^harness/src/(cli|cliArgs|commands|config|doctor|paths|versionCommand|linkCommand|testCommand|fixtureCommand|logCommand|perfSummary)\\.ts$"
      ],
      "human": [
        "docs/reference/cli.md",
        "docs/reference/configuration.md",
        "docs/get-started/set-up.md"
      ],
      "ai": ["harness/reference/cli.md", "harness/AGENTS.md"]
    },
    {
      "name": "Lifecycle and authentication",
      "sources": [
        "^harness/src/(instance|runningVortex|processes|bootstrap|auth|loginImport|runningProfile|mainPreload|bethesdaSandbox|sandbox|gameSetup|electronRuntime)\\.ts$"
      ],
      "human": [
        "docs/concepts/one-test-vortex.md",
        "docs/guides/sign-in.md",
        "docs/security.md",
        "docs/troubleshooting.md"
      ],
      "ai": ["harness/AGENTS.md", "KNOWLEDGE.md", "harness/TESTING.md"]
    },
    {
      "name": "Reusable script helpers",
      "sources": [
        "^harness/src/(kit|mcpClient|cdp|uiDriver|uiSession|localMod|deployment|collections|largeLibrary|tableProbes|collectionScale|offlineCollection|profiling|recording|slowDownload|downloadServer|vortexLog|jsonFile)\\.ts$"
      ],
      "human": ["docs/guides/drive-vortex.md", "docs/guides/benchmark.md"],
      "ai": ["harness/reference/script-api.md", "harness/AGENTS.md", "harness/TESTING.md"]
    },
    {
      "name": "Builds and evidence",
      "sources": [
        "^harness/src/(processRunner|source|vortexBuild|extensionBuild|extensionGeneration|hotReload|productionMode|evidence|prChecks|prPreflight|vortexE2e)\\.ts$"
      ],
      "human": [
        "docs/guides/source-development.md",
        "docs/concepts/evidence.md",
        "docs/contributing.md"
      ],
      "ai": [
        "harness/AGENT-WORKFLOW.md",
        "harness/WORKFLOWS.md",
        "harness/TESTING.md",
        "harness/AGENTS.md"
      ]
    },
    {
      "name": "Checks",
      "sources": [
        "^harness/src/tests/",
        "\\.test\\.ts$",
        "^harness/.*playwright\\.config\\.ts$",
        "^vitest\\.config\\.ts$",
        "^package\\.json$"
      ],
      "human": ["docs/guides/regression-tests.md", "docs/contributing.md"],
      "ai": ["harness/TESTING.md"]
    },
    {
      "name": "Harness implementation coverage",
      "sources": ["^harness/src/[^/]+\\.ts$"],
      "human": [
        "docs/reference/cli.md",
        "docs/reference/configuration.md",
        "docs/concepts/how-it-works.md"
      ],
      "ai": [
        "harness/reference/script-api.md",
        "harness/reference/cli.md",
        "harness/AGENTS.md",
        "harness/TESTING.md"
      ]
    },
    {
      "name": "Design-first workflow",
      "sources": ["^plugins/doodlebot/(resources|agents)/", "^designs/SITEMAP\\.md$"],
      "human": ["docs/guides/design-a-feature.md", "docs/concepts/design-first.md"],
      "ai": ["harness/AGENT-WORKFLOW.md", "harness/AGENTS.md"]
    },
    {
      "name": "Documentation maintenance",
      "sources": [
        "^scripts/docs",
        "^scripts/documentation-map\\.json$",
        "^mkdocs\\.yml$",
        "^requirements-docs\\.txt$"
      ],
      "human": ["docs/contributing.md"],
      "ai": ["AGENTS.md", "harness/KNOWLEDGE-ROUTES.md", "harness/AGENT-WORKFLOW.md"]
    }
  ]
}
