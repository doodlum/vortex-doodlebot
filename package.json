{
  "name": "doodlebot",
  "version": "2.0.0",
  "private": true,
  "description": "An agentic development and testing tool for Vortex: an MCP server inside Vortex, and a harness that launches, drives and verifies it",
  "homepage": "https://github.com/doodlum/vortex-doodlebot#readme",
  "bugs": "https://github.com/doodlum/vortex-doodlebot/issues",
  "license": "GPL-3.0-only",
  "author": "doodlum",
  "contributors": [
    "Alan Tse (original vortex-mcp, https://github.com/alandtse/vortex-mcp)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doodlum/vortex-doodlebot.git"
  },
  "bin": {
    "doodlebot": "bin/doodlebot.cjs"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsx harness/src/extensionBuild.ts",
    "dev": "tsx harness/src/cli.ts watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p harness/tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run docs:check && pnpm run docs:test && pnpm run qa:check && pnpm run test && pnpm run build",
    "docs:generate": "node scripts/docs.cjs --write",
    "docs:check": "node scripts/docs.cjs",
    "docs:test": "node --test scripts/docs.test.cjs",
    "qa:check": "node bin/doodlebot.cjs qa check",
    "docs:build": "node scripts/docs-run.cjs build",
    "docs:serve": "node scripts/docs-run.cjs serve"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "2.6.2",
    "@playwright/test": "1.61.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "fflate": "0.8.2",
    "jsdom": "^30.1.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "playwright": "1.61.1",
    "redux": "4.2.1",
    "tsup": "8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@9.15.0"
}
